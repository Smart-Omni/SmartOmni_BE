# Copy to .env and replace every placeholder. Do not commit .env.
POSTGRES_PASSWORD=replace_with_admin_password
DB_MIGRATION_PASSWORD=replace_with_migration_password
DB_APP_PASSWORD=replace_with_application_password
RABBITMQ_PASSWORD=replace_with_rabbitmq_password
JWT_SECRET=replace_with_a_random_secret_at_least_32_bytes_long
# Base64 of 32 random bytes, required by Integration when encrypting credentials.
SMARTOMNI_ENCRYPTION_AES_KEY=replace_with_base64_encoded_32_byte_key
# Shared token used only between the Java Quartz worker and internal job endpoints.
INTERNAL_JOB_TOKEN=replace_with_a_random_secret_at_least_32_characters_long
# Python FastAPI runs separately; Compose uses host.docker.internal:8000 by default.
# PYTHON_AI_BASE_URL=http://host.docker.internal:8000
# Shopee Open Platform App credentials (pointing to Shopee Simulator by default)
SHOPEE_PARTNER_ID=1001141
SHOPEE_PARTNER_KEY=shopee_mock_secret_key_2026
SHOPEE_BASE_URL=https://shopee-simulator.onrender.com
SHOPEE_AUTHORIZATION_URL=https://shopee-simulator.onrender.com/api/v2/shop/auth_partner
SHOPEE_REDIRECT_URI=http://localhost:5174/merchant/channels/shopee/callback

# TikTok simulator only. Match SEED_APP_KEY / SEED_APP_SECRET in the simulator's .env.
# The app secret below is fake test data; change both files together if using another value.
TIKTOK_APP_KEY=smartomni-dev-app-key
TIKTOK_APP_SECRET=smartomni-dev-app-secret-fake
TIKTOK_AUTHORIZATION_URL=http://localhost:3090/seller/authorize
# Browser uses localhost; with docker-compose.tiktok-simulator.yml the container uses the simulator network.
TIKTOK_TOKEN_BASE_URL=http://api:8090
TIKTOK_OPEN_API_BASE_URL=http://api:8090
# Web callback used when the client sends no redirect_uri. Without it the authorize URL has
# no redirect_uri and the simulator falls back to its first registered URI.
# Register every URI below exactly in the simulator's SEED_APP_REDIRECT_URIS.
# The 127.0.0.1 entry lets the FE send its own callback when opened at http://127.0.0.1:5174.
TIKTOK_REDIRECT_URI=http://localhost:5174/merchant/channels/tiktok-shop/callback
TIKTOK_ALLOWED_REDIRECT_URIS=smartomni://oauth/tiktok,http://127.0.0.1:5174/merchant/channels/tiktok-shop/callback
# Callback the simulator delivers webhooks to (all topics); must be reachable from the simulator container.
TIKTOK_WEBHOOK_URL=http://integration-service:8086/api/v1/integrations/tiktok/webhooks
